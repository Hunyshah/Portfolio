# Public site URL — used for canonical URLs, sitemap, robots and Open Graph.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: professional email shown on the site. Leave empty to hide it.
NEXT_PUBLIC_CONTACT_EMAIL=

# Contact form delivery via Resend (https://resend.com). Server-only — never prefix with NEXT_PUBLIC_.
# Without all three, the form tells visitors their message was NOT sent and points to direct links.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Portfolio <hello@your-domain.com>"
